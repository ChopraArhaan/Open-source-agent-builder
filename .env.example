# ==============================================================================
# Open Source Agent Builder Environment Variables
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# API Security & Authentication
# If set, endpoints (/agents, /tools, /run, /stream) require authentication
# via 'X-API-Key' or 'Authorization: Bearer <key>'. If empty, auth is disabled.
AGENT_BUILDER_API_KEY=

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "http://localhost:3000,http://localhost:5173").
# Defaults to empty (no allowed origins). Note: "*" is never paired with credentials.
CORS_ORIGINS=

# Agents Configuration Directory
AGENTS_DIR=agents

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Session & Memory Store Configuration
AGENT_BUILDER_DB_PATH=data/sessions.db
# Optional startup purge of sessions older than N days (disabled when empty)
AGENT_BUILDER_SESSION_TTL_DAYS=
# Optional history windowing budgets (disabled when empty)
AGENT_BUILDER_MAX_HISTORY_MESSAGES=
AGENT_BUILDER_MAX_HISTORY_CHARS=
